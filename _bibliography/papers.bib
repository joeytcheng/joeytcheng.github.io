  journal={Journal of Personality},
  volume={92},
  number={4},
  pages={1211--1228},
  year={2024},
  doi={10.1111/jopy.12882},
  abstract={This article uses a person-centered approach to examine how different configurations of power motives relate to personality and leadership-relevant outcomes. The findings highlight heterogeneity in how people pursue and experience power, showing that distinct motivational profiles are associated with different interpersonal and leadership patterns.},
  html={https://doi.org/10.1111/jopy.12882}
}

@article{cheng2024prestige,
