  volume={45},
  number={3},
  pages={319--320},
  year={2024},
  doi={10.1016/j.evolhumbehav.2024.04.007},
  abstract={This commentary argues that prestige-based leadership may create advantages for women leaders and help reduce gender inequality in leadership. It situates prestige-oriented influence as an alternative to dominance-based leader stereotypes and highlights implications for understanding preferences for women in leadership roles.},
  html={https://doi.org/10.1016/j.evolhumbehav.2024.04.007}
}

