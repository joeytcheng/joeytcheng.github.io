<style>
:root {
  --global-bg-color: #F3EAD9;
  --global-card-bg-color: #FFFFFF;
  --global-theme-color: #6B3A5D;
  --global-text-color: #1B1B2F;
  --global-text-color-light: #4a4a55;
  --global-divider-color: #E5DDC8;
  --icon-muted-color: #9C9BA6;
}

html[data-theme="dark"] {
  --global-bg-color: #1F1620;
