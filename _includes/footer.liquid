  --icon-muted-color: #B7AEC2;
}

.research-title,
.theme-text h2,
.feature-text h2,
.rq-band h2,
.people-title,
.faq-heading h2,
.contact-item-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 700 !important;
}

.site-footer {
  background: var(--global-theme-color);
  color: #ffffff;
  padding: 2.5rem 2rem 1.5rem;
  margin-top: 3rem;
}

.site-footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.site-footer-heading {
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 500;
  margin-bottom: 1rem;
}

.site-footer-text {
  color: #ffffff;
  font-size: 0.8rem;
  line-height: 1.8;
  opacity: 0.9;
}

.site-footer-link {
  display: block;
  font-size: 0.8rem;
  margin-top: 0.75rem;
}

.site-footer a {
  color: #ffffff !important;
  text-decoration: underline;
}

.site-footer-bottom {
  color: #ffffff;
  max-width: 1100px;
  margin: 2rem auto 0;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  font-size: 0.75rem;
  opacity: 0.85;
}

@media (max-width: 700px) {
  .site-footer-grid {
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
}
</style>

